; Engine configuration file.
config_version=5

[application]

config/name="FLOWLINE"
config/version="26"
config/quit_on_go_back=false
config/description="Endless highway traffic racer"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/brand/icon.png"

[audio]

driver/output_latency.android=40

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/flowline_age_signals/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/BarlowSemiCondensed-SemiBold.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.android="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.android=0
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
